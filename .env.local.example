# Local environment template.
# Copy this file to .env.local for Docker Compose/backend local runs.
# If running the frontend directly, copy NEXT_PUBLIC_API_URL into frontend/.env.local.
# Do not commit real API keys or secrets.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luvcraft
# Optional direct database URL for Alembic when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
CELERY_BROKER_URL=pyamqp://luvcraft:luvcraft@localhost:5672//
CELERY_RESULT_BACKEND=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# YouTube Collector
# Keep this empty in example files. Put your real key only in your local .env.local.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=VN
YOUTUBE_RELEVANCE_LANGUAGE=vi
YOUTUBE_MAX_RESULTS=50
YOUTUBE_MIN_RECORDS_THRESHOLD=20
YOUTUBE_TIMEOUT_MAX_RETRIES=3
YOUTUBE_TIMEOUT_RETRY_DELAY_SECONDS=60
DEBUG_HTTP=false

# Serpex Public Search Collector
# Keep this empty here. Put the real key only in ignored .env.local.
SERPEX_API_KEY=
SERPEX_MAX_RESULTS=10
SERPEX_TIMEOUT_SECONDS=10
SERPEX_MAX_RETRIES=3
SERPEX_RETRY_DELAY_SECONDS=60

# Hybrid Sentiment Analysis
# Keep GEMINI_API_KEY empty here. Put the real key only in ignored .env.local.
SENTIMENT_ENGINE=lexicon
GEMINI_API_KEY=
GEMINI_SENTIMENT_MODEL=gemini-3.1-flash-lite
GEMINI_SENTIMENT_PROMPT_VERSION=sentiment-gemini-v1
GEMINI_SENTIMENT_BATCH_SIZE=20
GEMINI_SENTIMENT_MAX_INPUT_CHARS=4000
GEMINI_SENTIMENT_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
# Optional: set both rates from your own billing source to estimate USD cost.
GEMINI_SENTIMENT_INPUT_COST_PER_MILLION_USD=
GEMINI_SENTIMENT_OUTPUT_COST_PER_MILLION_USD=

# Supabase Auth
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
