# Local environment template.
# Copy this file to .env.local for Docker Compose/backend local runs.
# If running the frontend directly, copy NEXT_PUBLIC_API_URL into frontend/.env.local.
# Do not commit real API keys or secrets.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luvcraft
# Optional direct database URL for Alembic when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
CELERY_BROKER_URL=pyamqp://luvcraft:luvcraft@localhost:5672//
CELERY_RESULT_BACKEND=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# YouTube Collector
# Keep this empty in example files. Put your real key only in your local .env.local.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=VN
YOUTUBE_RELEVANCE_LANGUAGE=vi
YOUTUBE_MAX_RESULTS=50
YOUTUBE_MIN_RECORDS_THRESHOLD=20
YOUTUBE_TIMEOUT_MAX_RETRIES=3
YOUTUBE_TIMEOUT_RETRY_DELAY_SECONDS=60
DEBUG_HTTP=false

# SerpApi Trends + Public Social Search
# Keep this empty here. Put the real key only in ignored .env.local.
SERPAPI_API_KEY=
SERPAPI_MAX_RESULTS=10
SERPAPI_TIMEOUT_SECONDS=10
SERPAPI_MAX_ATTEMPTS=3
SERPAPI_RETRY_INITIAL_DELAY_SECONDS=5
SERPAPI_RETRY_MAX_DELAY_SECONDS=30
SERPAPI_COLLECTOR_DEADLINE_SECONDS=120
SERPAPI_MAX_REQUESTS_PER_RUN=5
SERPAPI_LOW_QUOTA_THRESHOLD=10
SERPAPI_RELATED_QUERIES_ENABLED=true
SERPAPI_GEO_TRENDS_ENABLED=true
SERPAPI_GEO_COUNTRIES=VN,US,JP
SERPAPI_GEO_RELATED_COUNTRY_LIMIT=1
SERPAPI_MAX_REQUESTS_PER_RUN=5

# RSS/Atom Collector (feed URLs live in backend/app/conf/collectors.yaml)
# No API key is required.
RSS_MAX_RESULTS=50
RSS_TIMEOUT_SECONDS=15
RSS_MAX_RETRIES=3
RSS_RETRY_DELAY_SECONDS=30

# Hybrid Sentiment Analysis
# Keep GEMINI_API_KEY empty here. Put the real key only in ignored .env.local.
SENTIMENT_ENGINE=hybrid
GEMINI_API_KEY=
GEMINI_SENTIMENT_MODEL=gemini-3.1-flash-lite
GEMINI_SENTIMENT_PROMPT_VERSION=sentiment-gemini-v1
GEMINI_SENTIMENT_BATCH_SIZE=20
SENTIMENT_LLM_FALLBACK_THRESHOLD=0.65
GEMINI_SENTIMENT_MAX_INPUT_CHARS=4000
GEMINI_SENTIMENT_MAX_OUTPUT_TOKENS=4096
COMMUNITY_CLASSIFIER_ENGINE=hybrid
GEMINI_COMMUNITY_MODEL=gemini-3.1-flash-lite
GEMINI_COMMUNITY_PROMPT_VERSION=community-gemini-v2
GEMINI_COMMUNITY_BATCH_SIZE=25
GEMINI_COMMUNITY_MAX_INPUT_CHARS=4000
GEMINI_COMMUNITY_MAX_OUTPUT_TOKENS=4096
MOTIVATION_EXTRACTOR_ENGINE=hybrid
GEMINI_MOTIVATION_MODEL=gemini-3.1-flash-lite
GEMINI_MOTIVATION_PROMPT_VERSION=motivation-gemini-v2
GEMINI_MOTIVATION_BATCH_SIZE=25
GEMINI_MOTIVATION_MAX_INPUT_CHARS=4000
GEMINI_MOTIVATION_MAX_OUTPUT_TOKENS=4096
MOTIVATION_CONFIDENCE_THRESHOLD=0.72
TOPIC_EXTRACTOR_ENGINE=hybrid
GEMINI_TOPIC_MODEL=gemini-3.1-flash-lite
GEMINI_TOPIC_PROMPT_VERSION=subtopics-gemini-v2
GEMINI_TOPIC_BATCH_SIZE=25
GEMINI_TOPIC_MAX_INPUT_CHARS=4000
GEMINI_TOPIC_MAX_OUTPUT_TOKENS=4096
TOPIC_CONFIDENCE_THRESHOLD=0.72
TOPIC_MIN_TREND_EVIDENCE=3
DEMAND_EXTRACTOR_ENGINE=hybrid
GEMINI_DEMAND_MODEL=gemini-3.1-flash-lite
GEMINI_DEMAND_PROMPT_VERSION=demand-gemini-v2
GEMINI_DEMAND_BATCH_SIZE=25
GEMINI_DEMAND_MAX_INPUT_CHARS=4000
GEMINI_DEMAND_MAX_OUTPUT_TOKENS=4096
DEMAND_CONFIDENCE_THRESHOLD=0.72
# Brand-IP uses Gemini only for evidence-linked entity/semantic interpretation.
# Final weights, calculations, confidence, readiness and recommendations remain deterministic.
COLLABORATION_SEMANTIC_ENGINE=hybrid
GEMINI_COLLABORATION_MODEL=gemini-3.1-flash-lite
GEMINI_COLLABORATION_PROMPT_VERSION=brand-ip-semantic-v2
GEMINI_COLLABORATION_MAX_DOCUMENTS=30
GEMINI_COLLABORATION_MAX_INPUT_CHARS=1200
GEMINI_COLLABORATION_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
# Optional: set both rates from your own billing source to estimate USD cost.
GEMINI_SENTIMENT_INPUT_COST_PER_MILLION_USD=
GEMINI_SENTIMENT_OUTPUT_COST_PER_MILLION_USD=

# Supabase Auth
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# RBAC and Authorization
INTERNAL_EMAIL_DOMAINS=pluto.studio,projectpluto.studio
RBAC_ADMIN_EMAILS=
COOKIE_SECURE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Generated PDFs are stored outside the public web root. Relative paths resolve
# from the repository root; production should mount this directory persistently.
REPORT_STORAGE_PATH=data/reports
